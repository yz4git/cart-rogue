{
  "name": "voxel-rally",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:rules": "node --import tsx --test tests/rally-rules.test.ts tests/settings-safety.test.ts",
    "test:track": "node --import tsx --test tests/rally-track-geometry.test.ts",
    "test:cart": "node --import tsx --test tests/cart-arena-core.test.ts tests/cart-phase5.test.ts tests/cart-phase6.test.ts tests/cart-phase7.test.ts tests/cart-phase8.test.ts tests/cart-phase9.test.ts tests/cart-phase11.test.ts",
    "test:pwa": "node --test tests/pwa-cache.test.mjs tests/startup-safety.test.mjs",
    "test:pages": "npm run build:pages && node --test tests/rendered-html.test.mjs",
    "test": "npm run build && npm run test:rules && npm run test:track && npm run test:cart && npm run test:pwa && npm run test:pages",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "build:pages": "bash scripts/build-pages.sh",
    "verify": "npm test && npm run lint && npm run validate:artifact"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vinext": "0.0.50",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Cart Rogue"
}
